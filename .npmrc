# Supply-chain hardening, as in Foedrum (its DEPENDENCIES.md and ADR 0004).
# Never run dependency lifecycle scripts (install hooks are how most npm attacks run code).
ignore-scripts=true
# A version must be at least 7 days old before it can be resolved, so a hijacked release is
# usually caught and pulled before it reaches us. Versions already in the lock file are not re-checked.
min-release-age=7
# Exact versions in package.json: no range ever picks up a newer release by itself.
save-exact=true
# Registry tarballs only: no git or remote URL dependencies.
allow-git=none
allow-remote=none
# Do not auto-install peer dependencies.
omit=peer
# Refuse unsupported Node/npm versions.
engine-strict=true
fund=false
